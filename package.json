{
  "name": "ritl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "node scripts/generate-snippets.mjs && next build && node scripts/clean-static-export.mjs",
    "start": "next start -p 3020",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "echo 'No E2E tests yet — future slices will earn this lane.'",
    "test:full": "vitest run",
    "prepare": "husky",
    "snippets": "node scripts/generate-snippets.mjs",
    "brand-assets": "node scripts/generate-brand-assets.mjs",
    "snap": "node scripts/snap.mjs"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/material-nextjs": "^9.0.1",
    "next": "16.2.6",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fontkit": "^2.0.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.49.0",
    "prettier": "^3.8.3",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
